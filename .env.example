SUNSETSCOPE_BASE_URL=http://127.0.0.1:8000
SUNSETSCOPE_STORE_PATH=data/store.json
SUNSETSCOPE_SOURCE_TIMEOUT=15

# QQ 邮箱使用 SSL 465。授权码只能放在本地环境变量中。
SUNSETSCOPE_SMTP_HOST=smtp.qq.com
SUNSETSCOPE_SMTP_PORT=465
SUNSETSCOPE_SMTP_USER=your-address@qq.com
SUNSETSCOPE_SMTP_PASSWORD=your-new-authorization-code
SUNSETSCOPE_SMTP_FROM=your-address@qq.com
SUNSETSCOPE_ADMIN_EMAIL=your-address@qq.com

# 单个 IP 每小时最多触发 20 次邮件请求；单个邮箱最多 5 次。
SUNSETSCOPE_RATE_LIMIT_IP=20
SUNSETSCOPE_RATE_LIMIT_EMAIL=5
SUNSETSCOPE_RATE_LIMIT_WINDOW=3600
