[Unit]
Description=Daily 7000-step email reminder
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sunsetscope
Group=sunsetscope
WorkingDirectory=/opt/sunsetscope/current
EnvironmentFile=/opt/sunsetscope/.env
ExecStart=/opt/sunsetscope/venv/bin/python -m app.steps_reminder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sunsetscope
TimeoutStartSec=90
